# ============================================
# Quant Trading Bot - 환경변수 템플릿
# ============================================
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
#   cp .env.example .env
#
# 주의: .env 파일은 절대 git에 커밋하지 마세요!

# --- 한국투자증권 KIS OpenAPI ---
KIS_APP_KEY=
KIS_APP_SECRET=

# 트레이딩 모드: paper(모의투자) 또는 live(실전투자)
KIS_TRADING_MODE=paper

# 모드별 계좌번호 (모의/실전 계좌가 다른 경우)
KIS_PAPER_ACCOUNT_NO=
KIS_REAL_ACCOUNT_NO=
# 또는 단일 계좌: KIS_ACCOUNT_NO= (하위호환)

# 실전 모드 안전 확인 (live 모드 시 반드시 true로 설정해야 주문 실행됨)
KIS_LIVE_CONFIRMED=false

# --- DART OpenAPI (재무제표 수집) ---
DART_API_KEY=

# --- Telegram 알림 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 이메일 알림 (SMTP) ---
# 주간 리포트(JAE-71) 및 알림 발송용. 미설정 시 graceful degradation (로그만).
# Gmail 사용 시 SMTP_PASSWORD 는 일반 비밀번호가 아닌 "앱 비밀번호" 를 사용한다.
# 발급: https://myaccount.google.com/apppasswords (2단계 인증 활성 후)
# SMTP_RECIPIENTS 는 쉼표(,) 로 구분된 복수 수신자 지원.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=
SMTP_PASSWORD=
SMTP_RECIPIENTS=wogus3314@whatap.io

# --- GitHub 리서치 레포 자동 push (JAE-72) ---
# 주간 리포트 마크다운을 별도 비공개 레포에 누적 저장한다.
# 미설정 시 graceful degradation: scripts/push_weekly_report_to_github.py 가 경고 로그만 남기고 종료.
# GITHUB_TOKEN 은 repo write 권한이 있는 Personal Access Token.
GITHUB_TOKEN=
GITHUB_RESEARCH_REPO=wogus3314/quant-research
# 선택: GITHUB_RESEARCH_BRANCH=main (기본 main)
# 선택: GITHUB_RESEARCH_CACHE=~/.cache/quant-research-repo (로컬 클론 캐시)

# --- 알림 임계값 ---
ALERT_MDD_THRESHOLD=-0.15
ALERT_DAILY_MOVE_THRESHOLD=0.05

# --- KIS 리스크 관리 ---
KIS_MAX_ORDER_PCT=0.10
KIS_MAX_DAILY_TURNOVER=0.30
